# ============================================
# Sender App - Environment Variables
# ============================================
# Скопируйте этот файл в .env и заполните значения

# ============================================
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ
# ============================================

# SendGrid API Key для отправки email
SENDGRID_API_KEY=your_sendgrid_api_key

# Email отправителя (должен быть верифицирован в SendGrid)
SENDGRID_FROM=your_sendgrid_api_key

# Email администратора для уведомлений об ошибках
ADMIN_EMAIL=admin@example.com

# MongoDB connection string
# Для Docker: mongodb://username:password@host:port/database
# Для локальной разработки: mongodb://username:password@host:port/database
MONGO_URI=mongodb://username:password@host:port/database

# ============================================
# ОПЦИОНАЛЬНЫЕ ПЕРЕМЕННЫЕ
# ============================================

# Домен для SendGrid (по умолчанию: your_sendgrid_api_key)
SENDGRID_DOMAIN=your_sendgrid_api_key

# Email получателя для тестов (опционально)
SENDGRID_TO=your_sendgrid_api_key

# Имя отправителя по умолчанию
FROM_NAME=Seafarer_Sender_

# Тема письма по умолчанию
EMAIL_SUBJECT=Seafarer CV

# Окружение (production/development)
NODE_ENV=production

# Порт сервера (по умолчанию: 3000)
PORT=3000

# Set an explicit trusted frontend origin for credentialed requests.
# Wildcard (*) is only suitable for non-credentialed public access.
CORS_ORIGIN=http://localhost:8080

# ============================================
# GMAIL API (опционально, для проверки ответов)
# ============================================

# Включить проверку ответов через Gmail API
ENABLE_GMAIL_REPLY_CHECKER=true

# Google OAuth 2.0 Client ID (Desktop application)
GMAIL_CLIENT_ID=your_gmail_client_id.apps.googleusercontent.com

# Google OAuth 2.0 Client Secret
GMAIL_CLIENT_SECRET=your_gmail_client_secret

# Redirect URI для OAuth (для Desktop app используйте your_secret_value)
GMAIL_REDIRECT_URI=your_secret_value

# Refresh Token (получается через get-refresh-token.js)
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token

# Email для Gmail API (опционально)
GMAIL_SERVICE_EMAIL=your_secret_value
