# SendGrid API Configuration
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM=your_sendgrid_api_key
SENDGRID_DOMAIN=your_sendgrid_api_key

# Administrator Email
ADMIN_EMAIL=admin@example.com

# MongoDB Configuration
# Note: In Docker, this is overridden by docker-compose.yml
MONGO_URI=mongodb://username:password@host:port/database

# Server Configuration
PORT=3000
NODE_ENV=production

# Default Sender Information
FROM_NAME=Seafarer CV Team
EMAIL_SUBJECT=Seafarer Resume

# Gmail Reply Handler (Optional)
# Set to 'true' to enable automatic reply forwarding
ENABLE_GMAIL_REPLY_CHECKER=false
GMAIL_SERVICE_EMAIL=your_service_email@example.com

# Gmail Authentication (choose one):
# Option 1: OAuth2 Access Token
# GMAIL_ACCESS_TOKEN=your_oauth2_token_here

# Option 2: Service Account Key File
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/path/to/service-account-key.json
