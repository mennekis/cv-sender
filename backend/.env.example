# ============================================
# Environment Variables Configuration
# ============================================
# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env

# ============================================
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ
# ============================================

# SendGrid API ключ для отправки email
# Получить можно на https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key

# Email адрес отправителя (должен быть верифицирован в SendGrid)
# Формат: email@domain.com
SENDGRID_FROM=your_sendgrid_api_key

# Домен для SendGrid (используется для создания алиасов)
# По умолчанию: your_sendgrid_api_key
SENDGRID_DOMAIN=your_sendgrid_api_key

# Email адрес администратора для получения уведомлений об ошибках
ADMIN_EMAIL=admin@example.com

# MongoDB connection string
# Формат: mongodb://username:password@host:port/database
# Пример: mongodb://username:password@host:port/database
# Пример с аутентификацией: mongodb://username:password@host:port/database
MONGO_URI=mongodb://username:password@host:port/database

# ============================================
# ОПЦИОНАЛЬНЫЕ ПЕРЕМЕННЫЕ
# ============================================

# Порт на котором будет запущен сервер
# По умолчанию: 3000
PORT=3000

# Режим работы приложения
# Возможные значения: development, production
# По умолчанию: production
NODE_ENV=production

# CORS origin (разрешенные домены для запросов)
# Для production укажите конкретный домен, например: https://yourdomain.com
# Для разработки можно использовать: *
# По умолчанию: *
CORS_ORIGIN=*

# Имя отправителя по умолчанию
# Используется если не указано в запросе
FROM_NAME=Seafarer_Sender_

# Тема письма по умолчанию
# Используется если не указана в запросе
EMAIL_SUBJECT=Seafarer Resume

# Включить Gmail reply checker
# Установите в true для включения автоматической проверки ответов на письма
# Требует настройки Gmail API credentials
# По умолчанию: false
ENABLE_GMAIL_REPLY_CHECKER=false

# ============================================
# ПРИМЕЧАНИЯ
# ============================================
# 1. Никогда не коммитьте файл .env в git
# 2. Убедитесь, что все обязательные переменные заполнены перед запуском
# 3. В production используйте безопасные значения для CORS_ORIGIN
# 4. SENDGRID_FROM должен быть верифицирован в SendGrid перед использованием
